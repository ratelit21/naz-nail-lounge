---
import { Image } from 'astro:assets';
import svcManicure from '../assets/photos/svc-manicure-fill.jpg';
import svcColor from '../assets/photos/svc-color-fill.jpg';
import svcDesign from '../assets/photos/svc-design-fill.jpg';
import processWork from '../assets/photos/process-work.jpg';
import aboutStations from '../assets/photos/about-stations.jpg';
import { copy } from '../data/site';

const frames = [
  { title: 'Молочное покрытие', alt: 'Маникюр с молочным покрытием', src: svcManicure, pos: '50% 42%' },
  { title: 'Лиловое покрытие', alt: 'Лиловое покрытие на ногтях: работа NAZ', src: svcColor, pos: '48% 38%' },
  { title: 'Графичный дизайн', alt: 'Контрастный маникюр: работа NAZ', src: svcDesign, pos: '52% 36%' },
  { title: 'В работе', alt: 'Мастер выполняет аппаратный маникюр в NAZ', src: processWork, pos: '50% 40%' },
  { title: 'Станции', alt: 'Рабочие станции маникюра в NAZ Nail Lounge', src: aboutStations, pos: '50% 45%' },
  // Второй проход — лента плотнее на широком экране.
  { title: 'Молочное покрытие', alt: 'Маникюр с молочным покрытием', src: svcManicure, pos: '50% 42%' },
  { title: 'Лиловое покрытие', alt: 'Лиловое покрытие на ногтях: работа NAZ', src: svcColor, pos: '48% 38%' },
  { title: 'Графичный дизайн', alt: 'Контрастный маникюр: работа NAZ', src: svcDesign, pos: '52% 36%' },
];
---

<section class="services-band" id="services" aria-labelledby="services-title" data-reveal>
  <div class="wrap services-grid">
    <header class="services-head" data-reveal-item>
      <p class="eyebrow">Меню красоты</p>
      <h2 class="services-title" id="services-title">{copy.servicesTitle}</h2>
      <p class="services-lead">{copy.servicesLead}</p>
      <p class="services-note">{copy.servicesNote}</p>
    </header>
  </div>

  <div class="svc-rail" data-reveal-item>
    <div class="svc-marquee" data-svc-marquee role="group" aria-label="Реальные работы NAZ">
      <div class="svc-track">
        <div class="svc-set">
          {frames.map((frame) => (
            <figure class="svc-item">
              <div class="svc-frame">
                <Image
                  src={frame.src}
                  alt={frame.alt}
                  widths={[360, 560, 800]}
                  sizes="(max-width: 767px) 68vw, 280px"
                  quality={74}
                  loading="lazy"
                  decoding="async"
                  style={`object-position: ${frame.pos}`}
                />
              </div>
              <figcaption class="svc-caption">{frame.title}</figcaption>
            </figure>
          ))}
        </div>
        <div class="svc-set" aria-hidden="true">
          {frames.map((frame) => (
            <figure class="svc-item">
              <div class="svc-frame">
                <Image
                  src={frame.src}
                  alt=""
                  widths={[360, 560, 800]}
                  sizes="(max-width: 767px) 68vw, 280px"
                  quality={74}
                  loading="lazy"
                  decoding="async"
                  style={`object-position: ${frame.pos}`}
                />
              </div>
              <figcaption class="svc-caption">{frame.title}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .svc-marquee[data-interactive] {
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }
  .svc-marquee[data-interactive].is-dragging { cursor: grabbing; }
  .svc-marquee[data-interactive] img {
    pointer-events: none;
    -webkit-user-drag: none;
  }
</style>
<script>
  // Only the services photo rail is affected; other page animations stay unchanged.
  (() => {
    if (window.__nazServicesMarqueeReady) return;
    window.__nazServicesMarqueeReady = true;
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    let activeMarquee = null;
    let teardownMarquee = () => {};
    function mountServicesMarquee() {
      const marquee = document.querySelector('[data-svc-marquee]');
      if (marquee === activeMarquee && !reducedMotion.matches) return;
      teardownMarquee();
      if (!marquee || reducedMotion.matches) return;
      const track = marquee.querySelector('.svc-track');
      const firstSet = track?.querySelector('.svc-set');
      if (!track || !firstSet) return;
      let setWidth = firstSet.getBoundingClientRect().width;
      if (!setWidth) return;
      const controller = new AbortController();
      const {signal} = controller;
      const wrap = value => ((value % setWidth) + setWidth) % setWidth;
      const cssTransform = getComputedStyle(track).transform;
      let offset = 0;
      // Preserve position when switching from the CSS fallback animation.
      if (cssTransform.startsWith('matrix(')) {
        offset = -Number(cssTransform.slice(7,-1).split(',')[4]) || 0;
      } else if (cssTransform.startsWith('matrix3d(')) {
        offset = -Number(cssTransform.slice(9,-1).split(',')[12]) || 0;
      }
      offset = wrap(offset);
      let speed = setWidth / (innerWidth <= 767 ? 42 : 45);
      let hovered = false;
      let dragging = false;
      let activePointer = null;
      let previousX = 0;
      let lastFrame = performance.now();
      let frameId = 0;
      track.style.animation = 'none';
      marquee.dataset.interactive = '';
      const draw = () => {
        track.style.transform = 'translate3d(' + (-offset) + 'px,0,0)';
      };
      const animate = now => {
        const dt = Math.min((now - lastFrame)/1000,0.05);
        lastFrame = now;
        const target = dragging || hovered ? 0 : setWidth / (innerWidth <= 767 ? 42 : 45);
        speed += (target - speed) * (1 - Math.exp(-8 * dt));
        if (!dragging) offset = wrap(offset + speed * dt);
        draw();
        frameId = requestAnimationFrame(animate);
      };
      marquee.addEventListener('pointerenter', event => {
        if (event.pointerType === 'mouse') hovered = true;
      }, {signal});
      marquee.addEventListener('pointerleave', event => {
        if (event.pointerType === 'mouse') hovered = false;
      }, {signal});
      marquee.addEventListener('pointerdown', event => {
        if (dragging || !event.isPrimary || event.button !== 0) return;
        dragging = true;
        activePointer = event.pointerId;
        previousX = event.clientX;
        speed = 0;
        marquee.classList.add('is-dragging');
        if (event.pointerType === 'mouse') event.preventDefault();
        marquee.setPointerCapture(event.pointerId);
      }, {signal});
      marquee.addEventListener('pointermove', event => {
        if (!dragging || event.pointerId !== activePointer) return;
        const dx = event.clientX - previousX;
        previousX = event.clientX;
        offset = wrap(offset - dx);
        draw();
      }, {signal});
      const finishDrag = event => {
        if (!dragging || event.pointerId !== activePointer) return;
        dragging = false;
        activePointer = null;
        marquee.classList.remove('is-dragging');
        if (event.pointerType !== 'mouse') hovered = false;
        if (marquee.hasPointerCapture(event.pointerId)) marquee.releasePointerCapture(event.pointerId);
      };
      marquee.addEventListener('pointerup',finishDrag,{signal});
      marquee.addEventListener('pointercancel',finishDrag,{signal});
      marquee.addEventListener('lostpointercapture',finishDrag,{signal});
      const resizeObserver = new ResizeObserver(() => {
        const width = firstSet.getBoundingClientRect().width;
        if (!width || width === setWidth) return;
        offset = (offset / setWidth) * width;
        setWidth = width;
        draw();
      });
      resizeObserver.observe(firstSet);
      draw();
      frameId = requestAnimationFrame(animate);
      activeMarquee = marquee;
      teardownMarquee = () => {
        cancelAnimationFrame(frameId);
        resizeObserver.disconnect();
        controller.abort();
        marquee.classList.remove('is-dragging');
        delete marquee.dataset.interactive;
        track.style.removeProperty('animation');
        track.style.removeProperty('transform');
        activeMarquee = null;
        teardownMarquee = () => {};
      };
    }
    document.addEventListener('astro:page-load',mountServicesMarquee);
    document.addEventListener('astro:before-swap',()=>teardownMarquee());
    reducedMotion.addEventListener('change',mountServicesMarquee);
    mountServicesMarquee();
  })();
</script>
