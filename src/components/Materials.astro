---
import { Image } from 'astro:assets';
import aboutStations from '../assets/photos/about-stations.jpg';
import aboutDetails from '../assets/photos/about-details.jpg';
import aboutStairs from '../assets/photos/about-stairs.jpg';

interface Props {
  featured?: boolean;
}

const { featured = false } = Astro.props;

const strips = [
  { src: aboutStations, alt: 'Станции маникюра и резной гирих в NAZ', label: 'Станции', pos: '50% 42%' },
  { src: aboutDetails, alt: 'Керамика и детали пространства NAZ', label: 'Детали', pos: '50% 45%' },
  { src: aboutStairs, alt: 'Лестница и свет у окна салона', label: 'Свет', pos: '55% 35%' },
];
---

<section
  class:list={['materials', featured && 'materials-featured']}
  id={featured ? 'materials' : undefined}
  aria-label={featured ? 'Материалы пространства' : undefined}
  aria-hidden={featured ? undefined : 'true'}
  data-reveal={featured ? true : undefined}
>
  {strips.map((strip) => (
    <figure class="materials-item" data-reveal-item={featured ? true : undefined}>
      <Image
        src={strip.src}
        alt={featured ? strip.alt : ''}
        widths={[640, 960, 1280, 1600]}
        sizes={featured ? '(max-width:767px) 100vw, 34vw' : '(max-width: 767px) 90vw, 34vw'}
        quality={88}
        loading={featured ? "eager" : "lazy"}
        decoding="async"
        style={`object-position: ${strip.pos}`}
      />
      {featured && <figcaption class="materials-caption">{strip.label}</figcaption>}
    </figure>
  ))}
</section>
