---
import '@fontsource/poiret-one/latin-400.css';
import '@fontsource/poiret-one/cyrillic-400.css';
import '@fontsource/tenor-sans/latin-400.css';
import '@fontsource/tenor-sans/cyrillic-400.css';
import poiretLatin from '@fontsource/poiret-one/files/poiret-one-latin-400-normal.woff2?url';
import poiretCyrillic from '@fontsource/poiret-one/files/poiret-one-cyrillic-400-normal.woff2?url';
import '../styles/global.css';
import '../styles/header-scroll.css';
import '../styles/hero-booking.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Preloader from '../components/Preloader.astro';
import { ClientRouter } from 'astro:transitions';
import { withBase } from '../lib/base';
import sharp from 'sharp';
import path from 'node:path';

interface Props {
  title?: string;
  description?: string;
  theme?: 'dark' | 'cream';
  nav?: 'home' | 'atmosphere';
}

const {
  title = 'Naz Nail Lounge — Уфа',
  description = 'Приватный nail lounge в Уфе. Аксакова, 18, вход со двора. Маникюр, педикюр, брови. Запись онлайн.',
  theme = 'dark',
  nav = 'home',
} = Astro.props;

// Tiny inlined versions of the REAL clay texture are present at first paint,
// even on a cold connection. Full-resolution variants load over them.
const previewFor = async (filename: string) => {
  const source = path.join(process.cwd(), 'public', 'textures', filename);
  return (await sharp(source).resize({width: 256}).webp({quality: 60, effort: 3}).toBuffer()).toString('base64');
};
const [introPreviewDesktop, introPreviewMobile] = nav === 'home'
  ? await Promise.all([
      previewFor('terracotta-plaster.webp'),
      previewFor('terracotta-plaster-mobile.webp'),
    ])
  : ['', ''];
const introFirstPaintCSS = `html.intro-active{--intro-preview:url("data:image/webp;base64,${introPreviewDesktop}");background:var(--intro-preview) center/cover no-repeat var(--intro-chrome,#bd7950)}`
  + `@media(max-width:767px){html.intro-active{--intro-preview:url("data:image/webp;base64,${introPreviewMobile}")}}`;
---

<!doctype html>
<html lang="ru" data-theme={theme} data-page={nav}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    {nav === 'home' && <style is:inline set:html={introFirstPaintCSS} />}
    {nav === 'home' && <>
      <link rel="preload" as="image" href={withBase('/textures/terracotta-plaster.webp')} media="(min-width: 768px)" fetchpriority="high" />
      <link rel="preload" as="image" href={withBase('/textures/terracotta-plaster-mobile.webp')} media="(max-width: 767px)" fetchpriority="high" />
    </>}
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="preload" href={poiretLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={poiretCyrillic} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <ClientRouter fallback="swap" />
    <script is:inline>
      (() => {
      // Document-load boot only; client-route state is prepared before the swap.
      if (window.nazDocumentBooted) return;
      window.nazDocumentBooted = true;
      const root = document.documentElement;
      const navigation = performance.getEntriesByType('navigation')[0];
      let internal = navigation?.type === 'back_forward';
      try {
        const pending = JSON.parse(sessionStorage.getItem('naz-internal-navigation') || 'null');
        sessionStorage.removeItem('naz-internal-navigation');
        if(navigation?.type !== 'reload' && pending?.path === location.pathname && Date.now()-pending.time < 10000) internal = true;
      } catch {}
      try {
        if(navigation?.type === 'navigate' && document.referrer) {
          const from = new URL(document.referrer);
          if(from.origin === location.origin && from.pathname !== location.pathname) internal = true;
        }
      } catch {}
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        // Card intro once per browser profile; reload skips it. Clearing site data brings it back.
        let introSeen = false;
        try { introSeen = localStorage.getItem('naz-intro-seen') === '1'; } catch {}
        if(root.dataset.page === 'home' && !internal && !introSeen) {
          // Arm the page's invisible assembly state BEFORE any intro frame can paint.
          root.classList.add('intro-active', 'page-entering');
          root.dataset.pageEntry = 'pending';
          try { localStorage.setItem('naz-intro-seen', '1'); } catch {}
        } else {
          root.classList.add('page-entering');
        }
      }
      window.nazSafetyTimer = setTimeout(() => {
        root.classList.remove('intro-active', 'intro-revealing', 'page-entering');
        root.dataset.pageEntry = 'complete';
        document.querySelector('[data-image-stack]')?.setAttribute('style', 'display:none');
        document.querySelectorAll('[data-page-part], [data-page-visual] img').forEach(el => {
          ['opacity','transform','clip-path'].forEach(property => el.style.removeProperty(property));
        });
      }, root.classList.contains('intro-active') ? 15000 : 3200);
      })();
    </script>
  </head>
  <body class={`theme-${theme}`}>
    <a class="skip-link" href="#main">К содержанию</a>
    {nav === 'home' && <Preloader />}
    <div data-site-content>
      <Header nav={nav} theme={nav === 'home' ? 'cream' : theme} />
      <slot />
      <Footer theme={theme} />
    </div>
    <script>
      import '../scripts/page.ts';
      import '../scripts/header-scroll.ts';
    </script>
  </body>
</html>
