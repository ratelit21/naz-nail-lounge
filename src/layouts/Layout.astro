---
import '@fontsource/poiret-one/latin-400.css';
import '@fontsource/poiret-one/cyrillic-400.css';
import '@fontsource/tenor-sans/latin-400.css';
import '@fontsource/tenor-sans/cyrillic-400.css';
import poiretLatin from '@fontsource/poiret-one/files/poiret-one-latin-400-normal.woff2?url';
import poiretCyrillic from '@fontsource/poiret-one/files/poiret-one-cyrillic-400-normal.woff2?url';
import tenorLatin from '@fontsource/tenor-sans/files/tenor-sans-latin-400-normal.woff2?url';
import '../styles/global.css';
import '../styles/header-scroll.css';
import '../styles/browser-canvas.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Preloader from '../components/Preloader.astro';
import { ClientRouter } from 'astro:transitions';
import { withBase } from '../lib/base';

interface Props {
  title?: string;
  description?: string;
  theme?: 'dark' | 'cream';
  nav?: 'home' | 'atmosphere';
}

const {
  title = 'Naz Nail Lounge — Уфа',
  description = 'Приватный nail lounge в Уфе. Аксакова, 18, вход со двора. Маникюр, педикюр, брови. Запись онлайн.',
  theme = 'dark',
  nav = 'home',
} = Astro.props;
---

<!doctype html>
<html lang="ru" data-theme={theme} data-page={nav}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="preload" href={poiretLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={poiretCyrillic} as="font" type="font/woff2" crossorigin />
    {nav === 'home' && <>
      <link rel="preload" href={tenorLatin} as="font" type="font/woff2" crossorigin />
      <link rel="preload" href={withBase('/textures/terracotta-plaster-mobile.webp')} as="image" media="(prefers-reduced-motion: no-preference) and (max-width: 767px)" />
      <link rel="preload" href={withBase('/textures/terracotta-plaster.webp')} as="image" media="(prefers-reduced-motion: no-preference) and (min-width: 768px)" />
    </>}
    <title>{title}</title>
    <ClientRouter fallback="swap" />
    <script is:inline>
      (() => {
      // Document-load boot only; client-route state is prepared before the swap.
      if (window.nazDocumentBooted) return;
      window.nazDocumentBooted = true;
      const root = document.documentElement;
      const navigation = performance.getEntriesByType('navigation')[0];
      let internal = navigation?.type === 'back_forward';
      try {
        const pending = JSON.parse(sessionStorage.getItem('naz-internal-navigation') || 'null');
        sessionStorage.removeItem('naz-internal-navigation');
        if(navigation?.type !== 'reload' && pending?.path === location.pathname && Date.now()-pending.time < 10000) internal = true;
      } catch {}
      try {
        if(navigation?.type === 'navigate' && document.referrer) {
          const from = new URL(document.referrer);
          if(from.origin === location.origin && from.pathname !== location.pathname) internal = true;
        }
      } catch {}
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        // Card intro once per browser profile; survives refresh/re-entry, clears with site data.
        let introSeen = false;
        try { introSeen = localStorage.getItem('naz-intro-seen') === '1'; } catch {}
        if(root.dataset.page === 'home' && !internal && !introSeen) {
          root.classList.add('intro-active');
          try { localStorage.setItem('naz-intro-seen', '1'); } catch {}
        } else root.classList.add('page-entering');
      }
      // Prepare real in-flow texture before the first body paint, not after
      // intro photos decode. Fixed viewport covers cannot paint under iOS UI.
      if (root.classList.contains('intro-active') &&
          matchMedia('(pointer: coarse)').matches &&
          CSS.supports('-webkit-touch-callout', 'none')) {
        root.classList.add('intro-safari-bleed');
      }
      window.nazSafetyTimer = setTimeout(() => {
        const releaseBleed = root.classList.contains('intro-safari-bleed');
        root.classList.remove('intro-active', 'intro-revealing', 'intro-safari-bleed', 'page-entering');
        root.dataset.pageEntry = 'complete';
        document.querySelector('[data-image-stack]')?.setAttribute('style', 'display:none');
        if (releaseBleed) window.scrollTo({top:0,left:0,behavior:'instant'});
        document.querySelectorAll('[data-page-part], [data-page-visual] img').forEach(el => {
          ['opacity','transform','clip-path'].forEach(property => el.style.removeProperty(property));
        });
      }, root.classList.contains('intro-active') ? 11000 : 3200);
      })();
    </script>
  </head>
  <body class={`theme-${theme}`}>
    <a class="skip-link" href="#main">К содержанию</a>
    {nav === 'home' && <Preloader />}
    <script is:inline>
      if (document.documentElement.classList.contains('intro-safari-bleed')) {
        // The extra texture above/below the viewport is already in the flow.
        // Run synchronously before the page below it is parsed or painted.
        const offset = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--intro-safari-top')) || 100;
        window.scrollTo({ top: offset, left: 0, behavior: 'instant' });
      }
    </script>
    <div data-site-content>
      <Header nav={nav} theme={nav === 'home' ? 'cream' : theme} />
      <slot />
      <Footer theme={theme} />
    </div>
    <script>
      import '../scripts/page.ts';
      import '../scripts/header-scroll.ts';
    </script>
  </body>
</html>
